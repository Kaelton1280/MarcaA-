# Supabase — crie em https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Banco de dados (Supabase → Project Settings → Database → Connection string)
# DATABASE_URL: Transaction mode (porta 6543) — usado pelo PrismaClient em runtime
# DIRECT_URL:   Session mode (porta 5432)     — usado pelo Prisma Migrate (prisma db push)
DATABASE_URL=
DIRECT_URL=

# Asaas — crie em https://www.asaas.com
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# WhatsApp via Z-API — crie em https://z-api.io
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=

# Proteção do cron — gere uma string aleatória longa
CRON_SECRET=

# URL do app (sem barra no final)
NEXT_PUBLIC_APP_URL=http://localhost:3000
